# ---------------------------------------------------------------
# FraudStream AI - frontend environment
# Copy to .env.local for development, or set these in Vercel/Netlify.
# Only the anon key belongs here. The service-role key must NEVER be
# placed in the frontend (PRD deployment.environment_variables).
# ---------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key. Safe for the browser when RLS is enabled.
VITE_SUPABASE_ANON_KEY=

# FastAPI detection engine base URL.
VITE_API_URL=http://localhost:8000

# Optional: allow browsing the dashboard without Supabase credentials, using
# only the local API. Never enable this on a deployed environment.
VITE_DEMO_MODE=false
