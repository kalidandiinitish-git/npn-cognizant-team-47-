      "alerts": {
        "method": "GET",
        "path": "/alerts",
        "purpose": "Return recent fraud alerts"
      },

      "account_risk": {
        "method": "GET",
        "path": "/accounts/high-risk",
        "purpose": "Return high-risk accounts"
      }
