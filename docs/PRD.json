  "api_requirements": {
    "base_url": "/api",

    "endpoints": {
      "health": {
        "method": "GET",
        "path": "/health",
        "purpose": "Check ML service availability"
      },

      "predict": {
        "method": "POST",
        "path": "/predict",
        "purpose": "Predict risk for one transaction"
      },

      "stream_start": {
        "method": "POST",
        "path": "/stream/start",
        "purpose": "Start pseudo-streaming test transactions"
      },

      "stream_stop": {
        "method": "POST",
        "path": "/stream/stop",
        "purpose": "Stop active pseudo-stream"
      },

      "stream_status": {
        "method": "GET",
        "path": "/stream/status",
        "purpose": "Return current streaming state"
      },

      "metrics": {
        "method": "GET",
        "path": "/metrics",
        "purpose": "Return model and streaming metrics"
