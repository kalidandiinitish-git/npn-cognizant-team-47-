  "functional_requirements": {
    "FR-001": {
      "name": "Dataset Upload",
      "description": "Allow administrators/developers to load historical transaction datasets.",
      "priority": "High"
    },

    "FR-002": {
      "name": "Data Preprocessing",
      "description": "Clean missing values, remove invalid records, normalize numerical features and encode categorical data where required.",
      "priority": "High"
    },

    "FR-003": {
      "name": "Feature Engineering",
      "description": "Generate transaction-level and account-level fraud indicators.",
      "priority": "High",
      "features": [
        "Transaction amount",
        "Transaction time",
        "Transaction frequency",
        "Account transaction frequency",
        "Average transaction amount",
        "Amount deviation",
        "Time since previous transaction",
        "Location deviation",
        "Merchant category",
        "Transaction velocity",
        "Historical fraud rate"
      ]
    },

    "FR-004": {
      "name": "Class Imbalance Handling",
      "description": "Handle the extremely low proportion of fraudulent transactions.",
      "methods": [
        "Class weighting",
        "Random undersampling",
        "SMOTE where appropriate",
        "Threshold tuning",
        "Precision-Recall analysis"
      ]
    },

    "FR-005": {
      "name": "Model Training",
      "description": "Train and compare multiple fraud/anomaly detection models.",
      "candidate_models": [
        "Logistic Regression",
        "Random Forest",
        "XGBoost",
        "Isolation Forest"
      ]
    },

    "FR-006": {
      "name": "Model Selection",
      "description": "Select the model based on fraud detection effectiveness and inference latency rather than accuracy alone.",
      "primary_metrics": [
        "Precision",
        "Recall",
        "F1 Score",
        "PR-AUC",
        "ROC-AUC",
        "False Positive Rate",
        "Inference Latency"
      ]
    },

    "FR-007": {
      "name": "Threshold Tuning",
      "description": "Tune the classification threshold to prioritize fraud recall while controlling false positives.",
      "risk_thresholds": {
        "low": "0.00 - 0.39",
        "medium": "0.40 - 0.69",
        "high": "0.70 - 0.89",
        "critical": "0.90 - 1.00"
      }
    },

    "FR-008": {
      "name": "Pseudo Streaming",
      "description": "Stream test transactions sequentially using a Python generator rather than processing the entire test dataset as one batch.",
      "required_pattern": "Python generator"
    },

    "FR-009": {
      "name": "Real-Time Prediction",
      "description": "Predict fraud risk for every incoming transaction immediately.",
      "target_latency_ms": 50
    },

    "FR-010": {
      "name": "Fraud Alert",
      "description": "Generate an alert when a transaction exceeds the configured fraud risk threshold."
    },

    "FR-011": {
      "name": "High-Risk Account Detection",
      "description": "Aggregate suspicious transactions and calculate account-level risk."
    },

    "FR-012": {
      "name": "Transaction Storage",
      "description": "Store streamed transaction details, predictions, risk scores and decisions in Supabase PostgreSQL."
    },

    "FR-013": {
      "name": "Live Dashboard",
      "description": "Display transaction events and fraud alerts in near real time."
    },

    "FR-014": {
      "name": "Authentication",
      "description": "Protect dashboard access using Supabase Authentication."
    }
  },

  "machine_learning_pipeline": {
    "step_1_data": {
      "source": "Public credit card fraud dataset or approved synthetic dataset",
      "input": "Historical transactions",
      "output": "Training and testing datasets"
    },

    "step_2_preprocessing": [
      "Remove duplicate records",
      "Handle missing values",
      "Validate numerical ranges",
      "Normalize/standardize required numerical features",
      "Encode categorical variables",
      "Separate target labels",
      "Prevent data leakage"
    ],

    "step_3_split": {
      "method": "Train/Validation/Test",
      "recommendation": "Prefer time-aware splitting when timestamps are available.",
      "reason": "Avoid future information leaking into historical training data."
    },

    "step_4_imbalance": {
      "problem": "Fraud transactions represent a very small fraction of all transactions.",
      "solution": [
        "Use class weights",
        "Evaluate with Precision-Recall metrics",
        "Use controlled resampling only on training data",
        "Tune fraud threshold"
      ]
    },

    "step_5_training": {
      "models": [
        "Logistic Regression baseline",
        "Random Forest",
        "XGBoost",
        "Isolation Forest"
      ],
      "selection_strategy": "Compare fraud recall, precision, PR-AUC, F1 and inference latency."
    },

    "step_6_threshold": {
      "goal": "Choose a practical fraud threshold instead of blindly using 0.5.",
      "example": {
        "threshold": 0.75,
        "interpretation": "Transactions with predicted fraud probability >= 0.75 are flagged as high risk."
      }
    },

    "step_7_serialization": {
      "model_file": "fraud_model.joblib",
      "preprocessor_file": "preprocessor.joblib",
      "metadata_file": "model_metadata.json"
    }
  },

  "pseudo_streaming": {
    "core_requirement": "Python generator",
    "concept": "The test dataset must be converted into an event-like transaction stream where one transaction is processed at a time.",
    "generator_responsibilities": [
      "Read transaction records sequentially",
      "Yield one transaction at a time",
      "Attach transaction identifier",
      "Preserve event timestamp",
      "Send transaction to prediction pipeline"
    ],
    "processing_loop": [
      "Receive transaction",
      "Validate schema",
      "Transform features",
      "Run model inference",
      "Calculate fraud probability",
      "Calculate risk level",
      "Update account risk",
      "Persist result",
      "Emit realtime event",
      "Continue to next transaction"
    ]
  },

