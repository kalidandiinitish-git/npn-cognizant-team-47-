{
  "project": {
    "name": "Real-Time Pseudo-Streaming Credit Card Fraud Detection",
    "short_name": "FraudStream AI",
    "category": "Anomaly Detection / Machine Learning / Real-Time Fraud Detection",
    "version": "1.0.0",
    "status": "Development",
    "objective": "Build a real-time pseudo-streaming fraud detection system that processes incoming credit card transactions one by one using Python generators, predicts fraud risk with low latency, flags high-risk transactions and accounts, and provides a live monitoring dashboard.",
    "primary_requirement": {
      "training": "Train an anomaly/fraud detection model using historical credit card transaction data.",
      "streaming": "Use Python generators to stream test transactions one at a time.",
      "prediction": "Perform real-time fraud prediction for every streamed transaction.",
      "latency": "Target end-to-end model inference latency below 50 milliseconds per transaction.",
      "risk_detection": "Assign a fraud probability/risk score and classify transactions into risk levels.",
      "account_monitoring": "Aggregate suspicious activity and flag high-risk accounts.",
      "dashboard": "Provide a live React dashboard showing transaction flow, fraud alerts, risk scores, metrics and account risk."
    }
  },

