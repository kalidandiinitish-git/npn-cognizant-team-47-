# ---------------------------------------------------------------
# FraudStream AI - ML engine environment
# Copy to .env and fill in. Never commit the real .env file.
# ---------------------------------------------------------------

# --- Supabase (server side) ---
# The service-role key bypasses Row Level Security. It must ONLY ever live
# here, on the server. Never place it in the React application.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Anon key is used only to verify end-user access tokens against Supabase Auth.
SUPABASE_ANON_KEY=

# --- Model artifacts ---
MODEL_PATH=models/fraud_model.joblib
PREPROCESSOR_PATH=models/preprocessor.joblib
MODEL_METADATA_PATH=models/model_metadata.json

# --- Dataset ---
# Absolute or relative path to the historical transaction dataset.
# If unset, the engine searches ml-engine/data/, then the repository parent folder.
DATA_PATH=
# Dataset used by the pseudo-stream (defaults to the held-out test split).
STREAM_DATA_PATH=data/stream_test.csv

# --- Streaming behaviour ---
# Delay between streamed transactions, in milliseconds. 0 = as fast as possible.
STREAM_DELAY_MS=120
# Safety cap on how many transactions a single stream run will process.
STREAM_MAX_TRANSACTIONS=50000
# How many processed rows to buffer before flushing to Supabase.
PERSIST_BATCH_SIZE=25

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of browser origins allowed to call this API.
# 5173 is `vite dev`, 4173 is `vite preview` (the production build).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Controls authentication on every /api route except /api/health.
#   unset  - enforce when Supabase is configured, allow through when it is not.
#            The local development default; requests are logged as unauthenticated.
#   true   - always enforce. If SUPABASE_URL / SUPABASE_ANON_KEY are missing the
#            API refuses protected routes with 503 rather than serving them open.
#   false  - never enforce. Only ever correct on a machine nobody else can reach.
# Set this to true on anything deployed, and set the Supabase keys with it.
REQUIRE_AUTH=true
LOG_LEVEL=INFO
